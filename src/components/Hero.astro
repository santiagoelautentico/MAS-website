---
import logoHero from "../assets/logoHomePage.svg";
import warning from "../assets/warning.svg";
import img1 from "../assets/fotosHome/1.webp";
import img2 from "../assets/fotosHome/2.webp";
import img3 from "../assets/fotosHome/3.webp";
import img4 from "../assets/fotosHome/4.webp";
import img5 from "../assets/fotosHome/5.webp";
import img6 from "../assets/fotosHome/6.webp";
import img7 from "../assets/fotosHome/7.webp";
import img8 from "../assets/fotosHome/8.webp";
import { Image } from "astro:assets";
---

<div class="hero-spacer">
  <Image src={logoHero} alt="" class="logo" />
  <div class="polygon">
    <Image src={warning} alt="todos los sabados a las 16hrs" class="warning" />
  </div>
  <section class="home-section" id="home-section">
    <div class="img-container">
      <Image src={img1} alt="Foto MAS" class="imgHero img1" data-speed="0.1" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img2} alt="Foto MAS" class="imgHero img2" data-speed="0.3" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img3} alt="Foto MAS" class="imgHero img3" data-speed="0.15" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img4} alt="Foto MAS" class="imgHero img4" data-speed="0.25" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img5} alt="Foto MAS" class="imgHero img5" data-speed="0.2" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img6} alt="Foto MAS" class="imgHero img6" data-speed="0.3" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img7} alt="Foto MAS" class="imgHero img7" data-speed="0.18" draggable={false} />
    </div>
    <div class="img-container">
      <Image src={img8} alt="Foto MAS" class="imgHero img8" data-speed="0.22" draggable={false} />
    </div>
  </section>
</div>

<style>
  /* ===== Animaciones compartidas ===== */
  @keyframes shrink {
    from {
      transform: translate(-50%, -50%) scale(2.5);
    }
    to {
      transform: translate(-50%, -50%) scale(1);
    }
  }
  @keyframes imagesShow {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes polygon {
    from {
      transform: translateX(25rem);
    }
    to {
      transform: translateX(0rem);
    }
  }

  /* ===== Base compartida (ambos breakpoints) ===== */
  .hero-spacer {
    height: 100dvh;
    width: 100%;
    position: relative;
  }

  .home-section {
    position: fixed;
    top: 0;
    left: 0;
    height: 100dvh;
    width: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .home-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: #2432db;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .is-covered::before {
    opacity: 1;
    pointer-events: auto;
  }

  .logo {
    position: fixed;
    top: 50%;
    left: 50%;
    width: clamp(16rem, 35vw, 35rem);
    z-index: 10;
    transform: translate(-50%, -50%) scale(2.5);
    animation: shrink 1s ease-out forwards;
  }

  .polygon {
    position: fixed;
    z-index: 100;
  }

  .warning {
    aspect-ratio: 1/1;
    height: max-content;
  }

  .imgHero {
    transform: scale(0);
    animation: imagesShow 1s ease-out forwards;
    animation-delay: 0.5s;
    border-radius: 50%;
    z-index: 1;
    object-fit: cover;
    object-position: center;
  }

  /* ===== <= 900px: layout en grid (código 2) ===== */
  @media (max-width: 900px) {
    .home-section {
      display: grid;
      grid-template-columns: 1fr 1fr 2fr;
      grid-template-rows: 1fr 1fr 1fr;
    }

    .imgHero {
      width: 22vw;
      height: 22vw;
    }

    .img-container:nth-child(1) {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .img-container:nth-child(2) {
      grid-column: 1/3;
      grid-row: 2/3;
      padding: 1rem;
      display: flex;
    }
    .img-container:nth-child(2) > .imgHero {
      width: 35vw;
      height: 35vw;
    }
    .img-container:nth-child(3) {
      padding: 1rem;
    }
    .img-container:nth-child(3) > .imgHero {
      width: 25vw;
      height: 25vw;
    }
    .img-container:nth-child(4) {
      grid-column: 3/3;
      grid-row: 2/3;
      display: flex;
      justify-content: end;
    }
    .img-container:nth-child(4) > .imgHero {
      width: 30vw;
      height: 30vw;
    }
    .img-container:nth-child(5) {
      grid-column: 1/2;
      grid-row: 1/2;
      padding: 1rem;
    }
    .img-container:nth-child(5) > .imgHero {
      width: 8rem;
      height: 8rem;
    }
    .img-container:nth-child(6) {
      grid-column: 3/3;
      grid-row: 3/3;
      padding: 1rem;
      display: flex;
      align-items: flex-end;
      padding-bottom: 5rem;
    }
    .img-container:nth-child(7) {
      grid-column: 2/3;
      grid-row: 3/3;
      padding: 1rem;
      display: flex;
    }
    .img-container:nth-child(7) > .imgHero {
      width: 6rem;
      height: 6rem;
    }
    .img-container:nth-child(8) {
      display: flex;
    }
    .img-container:nth-child(8) > .imgHero {
      width: 8rem;
      height: 8rem;
    }

    .polygon {
      right: 0;
      top: 16dvh;
    }
    .warning {
      width: clamp(9rem, 25vw, 30rem);
    }
  }

  /* ===== > 900px: layout disperso con posiciones absolutas (código 1) ===== */
  @media (min-width: 901px) {
    .home-section {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .imgHero {
      position: absolute;
    }

    .img1 {
      width: clamp(9rem, 30vmin, 16rem);
      height: clamp(9rem, 30vmin, 16rem);
      right: 15dvw;
      bottom: 20dvh;
    }
    .img2 {
      width: clamp(15rem, 35vmin, 23rem);
      height: clamp(15rem, 35vmin, 23rem);
      bottom: -30dvh;
      object-position: -28px -25px;
      position: relative;
    }
    .img3 {
      width: clamp(10rem, 20vmin, 15rem);
      height: clamp(10rem, 20vmin, 15rem);
      left: 2dvw;
      bottom: 3dvh;
    }
    .img4 {
      width: clamp(8rem, 20vmin, 14rem);
      height: clamp(8rem, 20vmin, 14rem);
      left: 15dvw;
      bottom: 25dvh;
    }
    .img5 {
      width: clamp(11rem, 22vmin, 22rem);
      height: clamp(11rem, 22vmin, 22rem);
      left: 5dvw;
      top: 5dvh;
    }
    .img6 {
      width: clamp(6rem, 20vmin, 14rem);
      height: clamp(6rem, 20vmin, 14rem);
      right: 2dvw;
      bottom: 4dvh;
    }
    .img7 {
      width: clamp(8rem, 20vmin, 17rem);
      height: clamp(8rem, 20vmin, 17rem);
      right: 20dvw;
      bottom: 60dvh;
    }
    .img8 {
      width: clamp(6rem, 20vmin, 13rem);
      height: clamp(6rem, 20vmin, 13rem);
      right: 50dvw;
      bottom: 60dvh;
    }

    .polygon {
      right: 1rem;
      top: 20dvh;
      transform: translateX(35rem);
      animation: polygon 1s ease-out forwards;
      animation-delay: 1s;
    }
    .warning {
      width: clamp(11rem, 25vw, 30rem);
    }

    @media screen and (min-width: 1650px) {
      .img1 {
        right: 20dvw;
      }
      .img2 {
        width: 30rem;
        height: 30rem;
      }
      .img3 {
        width: 20rem;
        height: 20rem;
      }
      .img4 {
        width: 15rem;
        height: 15rem;
        left: 20dvw;
      }
      .img5 {
        width: 28rem;
        height: 28rem;
        top: 5dvh;
      }
      .img8 {
        width: 20rem;
        height: 20rem;
        top: 8dvh;
        left: 35dvw;
      }
      .img7 {
        width: 22rem;
        height: 22rem;
        object-position: 86%;
        right: 25dvw;
      }
    }
  }
  .polygon {
    z-index: 5;
  }
</style>

<script>
  import { animate } from "motion";
  const heroSection = document.getElementById(
    "home-section",
  ) as HTMLElement | null;
  const polygonEl = document.querySelector(".polygon") as HTMLElement | null;
  const MAX_BLUR = 15; // px, ajustá a gusto
  const BLUR_THRESHOLD = 8; // px, a partir de acá se agrega la clase
  const POLYGON_EXIT_DISTANCE = 50; // rem, misma distancia que la animación de entrada
  const POLYGON_MAX_BLUR = 10; // px

  let ticking = false;
  let polygonFollowsScroll = false;

  function applyPolygonOffset(progress: number) {
    if (!polygonEl || !polygonFollowsScroll) return;
    polygonEl.style.transform = `translateX(${progress * POLYGON_EXIT_DISTANCE}rem)`;
    polygonEl.style.filter = `blur(${progress * POLYGON_MAX_BLUR}px)`;
  }

  function updateBlur() {
    if (!heroSection) return;

    const scrollY = window.scrollY;
    const maxScroll =
      document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? Math.min(scrollY / maxScroll, 1) : 0;
    const blurValue = progress * MAX_BLUR;

    heroSection.style.filter = `blur(${blurValue}px)`;
    heroSection.classList.toggle("is-covered", blurValue >= BLUR_THRESHOLD);

    applyPolygonOffset(progress);

    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateBlur);
      ticking = true;
    }
  }
  window.addEventListener("scroll", onScroll, { passive: true });

  // El polygon tiene una animación de entrada por CSS (solo en desktop).
  // Hasta que esa animación termine, la dejamos controlar el transform;
  // recién ahí el scroll toma el control para devolverlo hacia afuera.
  if (polygonEl) {
    const hasEntranceAnimation =
      getComputedStyle(polygonEl).animationName !== "none";

    if (hasEntranceAnimation) {
      polygonEl.addEventListener(
        "animationend",
        () => {
          polygonEl.style.animation = "none";
          polygonFollowsScroll = true;
          updateBlur();
        },
        { once: true },
      );
    } else {
      polygonFollowsScroll = true;
    }
  }

  updateBlur();

  const heroImages = document.querySelectorAll(".imgHero");

  heroImages.forEach((img) => {
    let posX = 0;
    let posY = 0;
    let dragEnabled = false;

    img.addEventListener(
      "animationend",
      () => {
        img.style.animation = "none";
        img.style.transform = "scale(1)";
        img.style.cursor = "grab";
        dragEnabled = true;
      },
      { once: true },
    );

    let startMouseX = 0,
      startMouseY = 0;
    let startPosX = 0,
      startPosY = 0;
    let isDragging = false;

    const onPointerDown = (e) => {
      if (!dragEnabled || window.innerWidth <= 900) return;
      e.preventDefault();

      startMouseX = e.clientX;
      startMouseY = e.clientY;
      startPosX = posX;
      startPosY = posY;

      isDragging = true;
      img.setPointerCapture(e.pointerId);
      img.style.cursor = "grabbing";
      img.style.zIndex = "50";
    };

    const onPointerMove = (e) => {
      if (!isDragging || window.innerWidth <= 900) return;
      if (e.buttons !== 1) return;

      const dx = e.clientX - startMouseX;
      const dy = e.clientY - startMouseY;

      posX = startPosX + dx;
      posY = startPosY + dy;

      animate(img, { x: posX, y: posY }, { duration: 0 });
    };

    const onPointerUp = (e) => {
      if (!isDragging) return;
      isDragging = false;
      img.releasePointerCapture(e.pointerId);
      img.style.cursor = "grab";
    };

    const onPointerCancel = (e) => {
      if (!isDragging) return;
      isDragging = false;
      img.releasePointerCapture(e.pointerId);
      img.style.cursor = "grab";
    };

    img.addEventListener("pointerdown", onPointerDown);
    window.addEventListener("pointermove", onPointerMove);
    window.addEventListener("pointerup", onPointerUp);
    window.addEventListener("pointercancel", onPointerCancel);
  });

  function setFixedHeight() {
    const heroSection = document.getElementById("home-section");
    if (heroSection) {
      heroSection.style.height = window.innerHeight + "px";
    }
  }
  window.addEventListener("load", setFixedHeight);
  window.addEventListener("resize", setFixedHeight);
</script>